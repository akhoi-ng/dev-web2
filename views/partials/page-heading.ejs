<div class="mb-6">
  <% if (locals.back) { %>
    <a href="<%= back.href %>" class="mb-2 inline-flex items-center gap-1 text-sm text-stone-500 hover:text-brand-700">← <%= back.label %></a>
  <% } %>
  <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl"><%= heading %></h1>
  <% if (locals.subheading) { %>
    <p class="mt-1 text-stone-500"><%= subheading %></p>
  <% } %>
</div>
