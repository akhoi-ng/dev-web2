<%
  // Biến nhận vào: page, totalPages, pageHref(p) -> URL của trang p (giữ lại bộ lọc, sắp xếp...)
  // Dãy số trang rút gọn: 1 … 4 5 [6] 7 8 … 20
  const pageItems = [];
  for (let p = 1; p <= totalPages; p++) {
    if (p === 1 || p === totalPages || Math.abs(p - page) <= 2) pageItems.push(p);
    else if (pageItems[pageItems.length - 1] !== "…") pageItems.push("…");
  }
  const pageBtn = "flex h-11 min-w-11 items-center justify-center rounded-xl px-3 text-[15px] font-semibold";
  const pageIdle = pageBtn + " border border-[#EADBD2] bg-white hover:bg-brand-50 hover:text-brand-700";
  const pageOff = pageBtn + " border border-[#F3E8E1] bg-white text-stone-300";
%>
<% if (totalPages > 1) { %>
  <nav class="mt-8 flex flex-wrap items-center justify-center gap-2" aria-label="Phân trang">
    <% if (page > 1) { %>
      <a href="<%= pageHref(page - 1) %>" class="<%= pageIdle %>" rel="prev" aria-label="Trang trước">‹</a>
    <% } else { %>
      <span class="<%= pageOff %>" aria-hidden="true">‹</span>
    <% } %>

    <% pageItems.forEach(function (p) { %>
      <% if (p === "…") { %>
        <span class="px-1 text-stone-400">…</span>
      <% } else if (p === page) { %>
        <span class="<%= pageBtn %> bg-ink text-white" aria-current="page"><%= p %></span>
      <% } else { %>
        <a href="<%= pageHref(p) %>" class="<%= pageIdle %>" aria-label="Trang <%= p %>"><%= p %></a>
      <% } %>
    <% }) %>

    <% if (page < totalPages) { %>
      <a href="<%= pageHref(page + 1) %>" class="<%= pageIdle %>" rel="next" aria-label="Trang sau">›</a>
    <% } else { %>
      <span class="<%= pageOff %>" aria-hidden="true">›</span>
    <% } %>
  </nav>
<% } %>
