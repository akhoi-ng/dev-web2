<%
  const path = locals.currentPath || "";
  const isAdmin = path.startsWith("/admin");
  const adminLinks = [
    { href: "/admin/dishes", label: "Món ăn" },
    { href: "/admin/chefs", label: "Đầu bếp" },
    { href: "/admin/ingredients", label: "Nguyên liệu" },
    { href: "/admin/bookings", label: "Đặt bàn" },
  ];
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title ? locals.title + " · " : "" %><%= RESTAURANT.name %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    // Bảng màu thương hiệu cho Tailwind CDN (chỉ tạo CSS, không gửi dữ liệu)
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: "#FDF3EF", 100: "#FBE7DF", 200: "#F6CDBF", 300: "#EDA48E", 400: "#E0735A",
              500: "#CC4A2F", 600: "#B8321C", 700: "#9A2816", 800: "#7A2013", 900: "#5C1910",
            },
            saffron: "#F4B13E",
            cream: "#FFF8F2",
            ink: "#2B1B17",
          },
        },
      },
    };
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: "Be Vietnam Pro", system-ui, sans-serif; }
    a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible { outline: 3px solid #F4B13E; outline-offset: 2px; }
    summary { list-style: none; }
    summary::-webkit-details-marker { display: none; }

    /* Bảng quản trị: trên điện thoại mỗi dòng thành một thẻ, nhãn cột lấy từ data-label */
    @media (max-width: 767px) {
      .rtable thead { display: none; }
      .rtable, .rtable tbody, .rtable tr, .rtable td { display: block; }
      .rtable tr { padding: 14px 16px; }
      .rtable td { padding: 5px 0 !important; }
      .rtable td[data-label] { display: flex; justify-content: space-between; align-items: center; gap: 16px; text-align: right; }
      .rtable td[data-label]::before { content: attr(data-label); flex: none; font-weight: 600; color: #78716c; text-align: left; }
      .rtable td.rt-title { font-size: 16px; padding-bottom: 8px !important; }
      .rtable td.rt-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; margin-top: 8px; padding-top: 12px !important; border-top: 1px solid #f5f5f4; }
      .rtable td.rt-actions a, .rtable td.rt-actions button { display: inline-flex; align-items: center; min-height: 44px; padding-left: 16px; padding-right: 16px; }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-cream text-ink">
  <header class="sticky top-0 z-20 border-b border-[#EADBD2] bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3">
      <a href="/dishes" class="flex items-center gap-3" aria-label="<%= RESTAURANT.name %> – về thực đơn">
        <%- include("logo", { size: 42 }) %>
        <span class="flex flex-col leading-tight">
          <span class="text-xl font-extrabold tracking-tight"><%= RESTAURANT.name %></span>
          <span class="text-xs font-medium text-stone-500"><%= RESTAURANT.tagline %></span>
        </span>
      </a>

      <!-- Điện thoại: nút Đặt bàn + menu thả xuống (details/summary, không cần JavaScript) -->
      <div class="flex items-center gap-2 md:hidden">
        <% if (!isAdmin) { %>
          <a href="/bookings/new" class="flex min-h-11 items-center rounded-full bg-brand-600 px-4 text-sm font-bold text-white hover:bg-brand-700">Đặt bàn</a>
        <% } %>
        <details class="relative">
          <summary class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-[#EADBD2] bg-white" aria-label="Mở menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </summary>
          <nav aria-label="Menu" class="absolute right-0 top-full z-30 mt-2 flex w-64 flex-col rounded-2xl border border-[#EADBD2] bg-white p-2 text-[15px] font-semibold shadow-lg">
            <a href="/dishes#thuc-don" class="flex min-h-11 items-center rounded-xl px-3 hover:bg-brand-50 hover:text-brand-700">Thực đơn</a>
            <a href="/about" class="flex min-h-11 items-center rounded-xl px-3 hover:bg-brand-50 hover:text-brand-700">Về chúng tôi</a>
            <a href="/bookings/new" class="flex min-h-11 items-center rounded-xl px-3 hover:bg-brand-50 hover:text-brand-700">Đặt bàn</a>
            <div class="my-2 border-t border-stone-100"></div>
            <a href="/dishes" class="flex min-h-11 items-center rounded-xl px-3 <%= isAdmin ? 'text-stone-500 hover:bg-stone-50' : 'bg-stone-100' %>">Trang khách hàng</a>
            <a href="/admin/dishes" class="flex min-h-11 items-center rounded-xl px-3 <%= isAdmin ? 'bg-stone-100' : 'text-stone-500 hover:bg-stone-50' %>">Trang quản trị</a>
          </nav>
        </details>
      </div>

      <div class="hidden flex-wrap items-center gap-2 md:flex">
        <% if (!isAdmin) { %>
          <nav aria-label="Điều hướng chính" class="flex items-center gap-1 text-[15px] font-semibold">
            <a href="/dishes#thuc-don" class="rounded-lg px-3 py-2.5 hover:text-brand-700">Thực đơn</a>
            <a href="/about" <%- path.startsWith("/about") ? 'aria-current="page"' : '' %> class="rounded-lg px-3 py-2.5 hover:text-brand-700 <%= path.startsWith('/about') ? 'text-brand-700' : '' %>">Về chúng tôi</a>
          </nav>
          <a href="/bookings/new" class="rounded-full bg-brand-600 px-5 py-2.5 text-[15px] font-bold text-white hover:bg-brand-700">Đặt bàn</a>
        <% } %>

        <!-- Chuyển nhanh giữa trang khách và trang quản trị -->
        <div class="flex rounded-full bg-stone-100 p-1 text-sm font-medium">
          <a href="/dishes"
             class="rounded-full px-4 py-1.5 <%= isAdmin ? 'text-stone-500 hover:text-ink' : 'bg-white text-ink shadow' %>">
            Khách hàng
          </a>
          <a href="/admin/dishes"
             class="rounded-full px-4 py-1.5 <%= isAdmin ? 'bg-ink text-white shadow' : 'text-stone-500 hover:text-ink' %>">
            Quản trị
          </a>
        </div>
      </div>
    </div>

    <% if (isAdmin) { %>
      <nav class="border-t border-stone-100 bg-ink" aria-label="Quản trị">
        <!-- Điện thoại: 4 tab chia đều chiều ngang; màn hình rộng: xếp liền nhau -->
        <div class="mx-auto grid max-w-6xl grid-cols-4 px-2 sm:flex sm:gap-1 sm:px-4">
          <% adminLinks.forEach(function (link) { const active = path.startsWith(link.href); %>
            <a href="<%= link.href %>"
               class="flex min-h-11 items-center justify-center border-b-2 px-1 text-center text-[13px] font-medium leading-tight sm:px-4 sm:text-sm <%= active ? 'border-saffron text-white' : 'border-transparent text-stone-400 hover:text-white' %>">
              <%= link.label %>
            </a>
          <% }) %>
        </div>
      </nav>
    <% } %>
  </header>

  <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
