<%# Tiêu chí trên URL không hợp lệ (ví dụ sửa tay ?minPrice=abc). Biến: errors, clearHref %>
<div class="rounded-3xl border border-dashed border-[#D9C3B7] bg-white p-8 text-center" role="alert" data-error-code="VALIDATION_FAILED">
  <p class="text-lg font-bold">Điều kiện tìm kiếm không hợp lệ</p>
  <ul class="mt-2 text-stone-500">
    <% errors.forEach(function (m) { %>
      <li><%= m %></li>
    <% }) %>
  </ul>
  <a href="<%= clearHref %>" class="mt-4 inline-block font-semibold text-brand-700 hover:underline">Xóa bộ lọc</a>
</div>
