<%- include("partials/header") %>

<%
  const card = "rounded-3xl border border-[#EADBD2] bg-white";
  const reasons = [
    { title: "Giá rõ ràng", text: "Giá in trên từng món, sắp xếp theo giá chỉ một chạm.",
      icon: '<path d="M20 12l-8 8-9-9V3h8z"></path><circle cx="7.5" cy="7.5" r="1.5"></circle>' },
    { title: "Biết món nào còn", text: "Món tạm hết được đánh dấu ngay trên thẻ, không gọi nhầm.",
      icon: '<circle cx="12" cy="12" r="9"></circle><path d="M8 12l3 3 5-6"></path>' },
    { title: "Thành phần minh bạch", text: "Mỗi món ghi đủ nguyên liệu và định lượng cho một phần ăn.",
      icon: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3"></path>' },
    { title: "Đầu bếp phụ trách", text: "Biết món của bạn do ai nấu, từ món Á đến món Ý và bánh ngọt.",
      icon: '<path d="M6 13a4 4 0 1 1 2-7.5A4 4 0 0 1 16 5.5 4 4 0 1 1 18 13v7H6z"></path><path d="M6 17h12"></path>' },
  ];
%>

<nav aria-label="Vị trí trang" class="mb-6 flex flex-wrap gap-2 text-sm text-stone-500">
  <a href="/dishes" class="hover:text-brand-700">Trang chủ</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page" class="font-semibold text-ink">Về chúng tôi</span>
</nav>

<!-- Giới thiệu -->
<section class="mb-14 flex flex-wrap items-center gap-10">
  <div class="flex min-w-0 flex-[1_1_440px] flex-col gap-5">
    <span class="self-start rounded-full bg-brand-100 px-3.5 py-1.5 text-sm font-bold text-brand-800">Về <%= RESTAURANT.name %></span>
    <h1 class="text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl">Bếp Việt &amp; Âu<br>cho những bữa ăn ấm áp.</h1>
    <p class="max-w-xl text-lg leading-relaxed text-stone-600">
      <%= RESTAURANT.name %> phục vụ <%= dishCount %> món, từ phở, bún chả đến mỳ Ý và bánh ngọt,
      do <%= chefs.length %> đầu bếp phụ trách. Chúng tôi muốn việc chọn món dễ như đọc một tờ thực đơn giấy:
      giá, thành phần và tình trạng từng món đều ghi rõ.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="/dishes#thuc-don" class="flex min-h-12 items-center rounded-2xl bg-brand-600 px-6 font-bold text-white hover:bg-brand-700">Xem thực đơn</a>
      <a href="/bookings/new" class="flex min-h-12 items-center rounded-2xl border border-[#D9C3B7] bg-white px-6 font-bold hover:bg-brand-50">Đặt bàn</a>
    </div>
  </div>
  <img src="<%= DEFAULT_DISH_IMAGE %>" alt="" aria-hidden="true"
       class="h-72 min-w-0 flex-[1_1_360px] rounded-3xl object-cover sm:h-80">
</section>

<!-- Vì sao chọn chúng tôi -->
<section class="mb-14" aria-labelledby="vi-sao">
  <h2 id="vi-sao" class="text-3xl font-extrabold tracking-tight">Gọi món không còn đoán mò</h2>
  <p class="mb-6 mt-2 max-w-2xl text-stone-600">Mọi thông tin bạn cần trước khi gọi món đều có sẵn, rõ ràng như trên tờ thực đơn giấy.</p>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% reasons.forEach(function (r) { %>
      <div class="flex flex-col gap-2.5 <%= card %> p-6">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-100">
          <%# icon là chuỗi SVG cố định viết sẵn ở trên, không phải dữ liệu người dùng %>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7A2013" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- r.icon %></svg>
        </span>
        <h3 class="text-lg font-bold"><%= r.title %></h3>
        <p class="text-[15px] leading-relaxed text-stone-600"><%= r.text %></p>
      </div>
    <% }) %>
  </div>
</section>

<!-- Đội ngũ đầu bếp -->
<% if (chefs.length > 0) { %>
  <section class="mb-14" aria-labelledby="dau-bep">
    <h2 id="dau-bep" class="text-3xl font-extrabold tracking-tight">Đội ngũ đầu bếp</h2>
    <p class="mb-6 mt-2 max-w-2xl text-stone-600">Mỗi món trong thực đơn đều có một đầu bếp phụ trách.</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% chefs.forEach(function (c) { %>
        <div class="flex items-center gap-4 <%= card %> p-5">
          <%- include("partials/chef-avatar", { chef: c, size: "h-16 w-16", textSize: "text-xl" }) %>
          <div class="flex min-w-0 flex-col">
            <span class="text-lg font-bold"><%= c.name %></span>
            <span class="text-sm text-stone-600"><%= c.specialty %></span>
            <span class="mt-1 text-sm font-semibold text-brand-700"><%= c._count.dishes %> món phụ trách</span>
          </div>
        </div>
      <% }) %>
    </div>
  </section>
<% } %>

<!-- Ghé thăm -->
<section class="flex flex-wrap items-center justify-between gap-8 rounded-3xl bg-ink p-8 text-white sm:p-12" aria-labelledby="ghe-tham">
  <div class="min-w-0 max-w-xl">
    <h2 id="ghe-tham" class="text-3xl font-extrabold leading-tight tracking-tight">Ghé thăm <%= RESTAURANT.name %></h2>
    <dl class="mt-5 flex flex-col gap-2 text-[#E9DCD5]">
      <div class="flex gap-2"><dt class="font-semibold text-white">Địa chỉ:</dt><dd><%= RESTAURANT.address %></dd></div>
      <div class="flex gap-2"><dt class="font-semibold text-white">Hotline:</dt><dd><a href="tel:<%= RESTAURANT.phone %>" class="hover:underline"><%= formatPhone(RESTAURANT.phone) %></a></dd></div>
      <div class="flex gap-2"><dt class="font-semibold text-white">Mở cửa:</dt><dd><%= RESTAURANT.hours %> mỗi ngày</dd></div>
    </dl>
  </div>
  <a href="/bookings/new" class="flex min-h-12 items-center rounded-2xl bg-brand-600 px-7 font-bold text-white hover:bg-brand-700">Đặt bàn ngay</a>
</section>

<%- include("partials/footer") %>
