<%- include("../partials/header") %>
<% const input = "mt-1 w-full rounded-xl border border-stone-300 px-4 py-2.5 text-center font-mono text-lg tracking-widest focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"; %>

<div class="mx-auto max-w-2xl">
  <%- include("../partials/page-heading", {
    heading: replacing ? "Thay thiết bị xác thực" : "Bật xác thực hai bước",
    subheading: replacing ? "Secret cũ vẫn dùng được cho tới khi bạn xác nhận mã của secret mới." : "MFA chỉ được bật sau khi bạn nhập đúng mã từ ứng dụng.",
    back: { href: "/account/security", label: "Bảo mật tài khoản" }
  }) %>
  <%- include("../partials/auth-alert", { errors, code, notice: null }) %>

  <div class="grid gap-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-stone-200 sm:grid-cols-[auto_1fr] sm:p-8">
    <div class="text-center">
      <img src="<%= qr %>" alt="Mã QR để thêm tài khoản vào ứng dụng Authenticator" width="220" height="220" class="mx-auto rounded-lg ring-1 ring-stone-200">
      <p class="mt-2 text-xs text-stone-500">1. Quét bằng ứng dụng Authenticator</p>
    </div>
    <div class="space-y-5">
      <div>
        <p class="text-sm font-semibold">Không quét được? Nhập tay secret này:</p>
        <p class="mt-1 break-all rounded-xl bg-stone-50 px-4 py-3 font-mono text-sm tracking-wider" data-mfa-secret><%= secretGroups %></p>
        <p class="mt-1 text-xs text-stone-500">Loại: dựa trên thời gian (TOTP), 6 chữ số, 30 giây.</p>
      </div>
      <form method="POST" action="/account/mfa/confirm" class="space-y-3">
        <%- include("../partials/csrf") %>
        <label for="code" class="text-sm font-semibold">2. Nhập mã 6 chữ số ứng dụng đang hiện</label>
        <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required class="<%= input %>" placeholder="123456">
        <button type="submit" class="w-full rounded-xl bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700">Xác nhận và bật MFA</button>
      </form>
      <form method="POST" action="/account/mfa/cancel">
        <%- include("../partials/csrf") %>
        <button type="submit" class="text-sm font-semibold text-stone-500 hover:text-brand-700">Hủy thiết lập</button>
      </form>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
