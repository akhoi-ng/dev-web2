<%- include("../partials/header") %>
<% const input = "mt-1 w-full rounded-xl border border-stone-300 px-4 py-2.5 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"; %>

<div class="mx-auto max-w-md">
  <%- include("../partials/page-heading", { heading: "Quên mật khẩu", subheading: "Nhập email đã đăng ký, chúng tôi gửi link đặt mật khẩu mới.", back: { href: "/login", label: "Đăng nhập" } }) %>
  <%- include("../partials/auth-alert", { errors, code, notice }) %>

  <form method="POST" action="/forgot" class="space-y-5 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-stone-200 sm:p-8">
    <%- include("../partials/csrf") %>
    <div>
      <label for="email" class="text-sm font-semibold">Email</label>
      <input id="email" name="email" type="email" value="<%= email %>" maxlength="254" autocomplete="email" required class="<%= input %>">
    </div>
    <button type="submit" class="w-full rounded-xl bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700">Gửi link đặt lại</button>
  </form>
</div>

<%- include("../partials/footer") %>
