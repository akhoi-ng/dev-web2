<%- include("../partials/header") %>
<% const input = "mt-1 w-full rounded-xl border border-stone-300 px-4 py-2.5 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"; %>

<div class="mx-auto max-w-md">
  <%- include("../partials/page-heading", { heading: "Đăng nhập", subheading: "Đăng nhập để quản lý món ăn." }) %>
  <%- include("../partials/auth-alert", { errors, code, notice }) %>

  <form method="POST" action="/login" class="space-y-5 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-stone-200 sm:p-8">
    <%- include("../partials/csrf") %>
    <% if (next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
    <div>
      <label for="email" class="text-sm font-semibold">Email</label>
      <input id="email" name="email" type="email" value="<%= email %>" maxlength="254" autocomplete="username" required class="<%= input %>">
    </div>
    <div>
      <div class="flex items-center justify-between">
        <label for="password" class="text-sm font-semibold">Mật khẩu</label>
        <a href="/forgot" class="text-sm font-semibold text-brand-700 hover:underline">Quên mật khẩu?</a>
      </div>
      <input id="password" name="password" type="password" maxlength="128" autocomplete="current-password" required class="<%= input %>">
    </div>
    <%# Backend quyết định có cần CAPTCHA (theo bộ đếm sai của email); browser chỉ hiện theo %>
    <% if (recaptchaSiteKey) { %>
      <%- include("../partials/captcha", { siteKey: recaptchaSiteKey }) %>
    <% } %>
    <button type="submit" class="w-full rounded-xl bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700">Đăng nhập</button>
    <p class="text-center text-sm text-stone-500">Chưa có tài khoản? <a href="/register" class="font-semibold text-brand-700 hover:underline">Đăng ký</a></p>
  </form>
</div>

<%- include("../partials/footer") %>
