<%
  // Biến nhận vào: action, values, errors, categories, chefs, ingredients, submitLabel, cancelHref
  const input = "mt-1 w-full rounded-xl border border-stone-300 px-4 py-2.5 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200";
%>
<%- include("../../partials/form-errors", { errors }) %>

<form method="POST" action="<%= action %>" class="space-y-5 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-stone-200 sm:p-8">
  <div>
    <label for="name" class="text-sm font-semibold">Tên món ăn <span class="text-red-500">*</span></label>
    <input id="name" name="name" type="text" value="<%= values.name %>" maxlength="100" class="<%= input %>" placeholder="VD: Phở bò">
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="price" class="text-sm font-semibold">Giá (VNĐ) <span class="text-red-500">*</span></label>
      <input id="price" name="price" type="text" inputmode="numeric" value="<%= values.price %>" class="<%= input %>" placeholder="VD: 75000">
    </div>
    <div>
      <label for="category" class="text-sm font-semibold">Danh mục</label>
      <select id="category" name="category" class="<%= input %> bg-white">
        <option value="">— Không phân loại —</option>
        <% categories.forEach(function (c) { %>
          <option value="<%= c %>" <%= values.category === c ? "selected" : "" %>><%= c %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div>
    <label for="description" class="text-sm font-semibold">Mô tả</label>
    <textarea id="description" name="description" rows="4" maxlength="1000" class="<%= input %>" placeholder="Thành phần, hương vị..."><%= values.description %></textarea>
  </div>

  <div>
    <label for="imageUrl" class="text-sm font-semibold">URL hình ảnh</label>
    <input id="imageUrl" name="imageUrl" type="text" value="<%= values.imageUrl %>" class="<%= input %>" placeholder="https://images.unsplash.com/...">
    <p class="mt-1 text-xs text-stone-500">Để trống sẽ dùng ảnh mặc định.</p>
  </div>

  <div>
    <label for="chefId" class="text-sm font-semibold">Đầu bếp phụ trách</label>
    <select id="chefId" name="chefId" class="<%= input %> bg-white">
      <option value="">— Chưa phân công —</option>
      <% chefs.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= values.chefId === String(c.id) ? "selected" : "" %>><%= c.name %> · <%= c.specialty %></option>
      <% }) %>
    </select>
    <% if (chefs.length === 0) { %>
      <p class="mt-1 text-xs text-stone-500">Chưa có đầu bếp. <a href="/admin/chefs/new" class="text-brand-700 hover:underline">Thêm đầu bếp</a></p>
    <% } %>
  </div>

  <fieldset>
    <legend class="text-sm font-semibold">Công thức (nguyên liệu cho 1 phần ăn)</legend>
    <p class="mb-2 mt-1 text-xs text-stone-500">Tích chọn nguyên liệu và nhập định lượng theo đơn vị của nguyên liệu (VD: 0,25 kg).</p>
    <% if (ingredients.length === 0) { %>
      <p class="rounded-xl border border-dashed border-stone-300 p-4 text-sm text-stone-500">
        Chưa có nguyên liệu. <a href="/admin/ingredients/new" class="text-brand-700 hover:underline">Thêm nguyên liệu</a>
      </p>
    <% } else { %>
      <div class="max-h-80 divide-y divide-stone-100 overflow-y-auto rounded-xl border border-stone-300">
        <% ingredients.forEach(function (ing) {
             const v = values.ingredients[String(ing.id)] || { selected: false, quantity: "" }; %>
          <div class="flex items-center gap-3 px-4 py-2 <%= v.selected ? 'bg-brand-50' : '' %>">
            <input type="checkbox" id="ing-<%= ing.id %>" name="ingredientIds" value="<%= ing.id %>" <%= v.selected ? "checked" : "" %>
                   class="h-4 w-4 rounded border-stone-300 text-brand-600 focus:ring-brand-400">
            <label for="ing-<%= ing.id %>" class="flex-1 text-sm"><%= ing.name %></label>
            <input type="text" inputmode="decimal" name="qty_<%= ing.id %>" value="<%= v.quantity %>" aria-label="Định lượng <%= ing.name %>"
                   class="w-24 rounded-lg border border-stone-300 px-2 py-1 text-right text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200" placeholder="0">
            <span class="w-12 text-xs text-stone-500"><%= ing.unit %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </fieldset>

  <label class="flex items-center gap-3">
    <input type="checkbox" name="available" <%= values.available ? "checked" : "" %> class="h-5 w-5 rounded border-stone-300 text-brand-600 focus:ring-brand-400">
    <span class="font-medium">Còn món (đang phục vụ)</span>
  </label>

  <div class="flex flex-wrap gap-3 border-t border-stone-100 pt-5">
    <button type="submit" class="rounded-xl bg-brand-600 px-6 py-2.5 font-semibold text-white hover:bg-brand-700"><%= submitLabel %></button>
    <a href="<%= cancelHref %>" class="rounded-xl border border-stone-300 px-6 py-2.5 font-semibold hover:bg-stone-100">Hủy</a>
  </div>
</form>
