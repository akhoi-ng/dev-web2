<%- include("../../partials/header") %>

<div class="mx-auto max-w-xl">
  <%- include("../../partials/page-heading", {
    heading: "Xác nhận xóa món ăn",
    back: { href: "/admin/dishes", label: "Danh sách món ăn" }
  }) %>

  <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-red-200">
    <div class="flex gap-4 p-6">
      <img src="<%= dish.imageUrl || DEFAULT_DISH_IMAGE %>" alt="" class="h-24 w-24 flex-none rounded-xl object-cover">
      <div>
        <p class="text-xs text-stone-400">#<%= dish.id %> · <%= dish.category || "Không phân loại" %></p>
        <p class="text-lg font-bold"><%= dish.name %></p>
        <p class="font-semibold text-brand-600"><%= formatPrice(dish.price) %></p>
      </div>
    </div>

    <div class="border-t border-red-100 bg-red-50 px-6 py-4 text-sm text-red-700">
      Bạn có chắc muốn xóa món <strong><%= dish.name %></strong>? Thao tác này không thể hoàn tác.
    </div>

    <div class="flex flex-wrap gap-3 px-6 py-4">
      <form method="POST" action="/admin/dishes/<%= dish.id %>?_method=DELETE">
        <button type="submit" class="rounded-xl bg-red-600 px-5 py-2.5 font-semibold text-white hover:bg-red-700">Xác nhận xóa</button>
      </form>
      <a href="/admin/dishes" class="rounded-xl border border-stone-300 px-5 py-2.5 font-semibold hover:bg-stone-100">Hủy</a>
    </div>
  </div>
</div>

<%- include("../../partials/footer") %>
