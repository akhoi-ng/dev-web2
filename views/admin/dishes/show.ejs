<%- include("../../partials/header") %>

<div class="mx-auto max-w-3xl">
  <%- include("../../partials/page-heading", {
    heading: dish.name,
    subheading: "Món ăn #" + dish.id,
    back: { href: "/admin/dishes", label: "Danh sách món ăn" }
  }) %>

  <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-stone-200">
    <img src="<%= dish.imageUrl || DEFAULT_DISH_IMAGE %>" alt="<%= dish.name %>" class="aspect-[16/7] w-full object-cover">

    <dl class="divide-y divide-stone-100 text-sm">
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">Tên món</dt><dd class="sm:col-span-2 font-semibold"><%= dish.name %></dd></div>
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">Giá</dt><dd class="sm:col-span-2 font-semibold text-brand-600"><%= formatPrice(dish.price) %></dd></div>
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">Danh mục</dt><dd class="sm:col-span-2"><%= dish.category || "—" %></dd></div>
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4">
        <dt class="text-stone-500">Đầu bếp phụ trách</dt>
        <dd class="sm:col-span-2">
          <% if (dish.chef) { %>
            <a href="/admin/chefs/<%= dish.chef.id %>" class="inline-flex items-center gap-2 font-semibold hover:text-brand-700">
              <%- include("../../partials/chef-avatar", { chef: dish.chef, size: "h-7 w-7", textSize: "text-xs" }) %>
              <%= dish.chef.name %>
            </a>
            <span class="text-stone-500">· <%= dish.chef.specialty %></span>
          <% } else { %>
            <span class="text-stone-400">Chưa phân công</span>
          <% } %>
        </dd>
      </div>
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">Trạng thái</dt><dd class="sm:col-span-2"><%= dish.available ? "Còn món" : "Hết món" %></dd></div>
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">Mô tả</dt><dd class="sm:col-span-2 text-stone-700"><%= dish.description || "—" %></dd></div>
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">URL ảnh</dt><dd class="sm:col-span-2 break-all text-stone-500"><%= dish.imageUrl || "(dùng ảnh mặc định)" %></dd></div>
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">Ngày tạo</dt><dd class="sm:col-span-2"><%= dish.createdAt.toLocaleString("vi-VN") %></dd></div>
    </dl>

    <div class="border-t border-stone-100 px-6 py-4">
      <h2 class="mb-3 text-sm font-semibold">Công thức · <%= dish.ingredients.length %> nguyên liệu / phần</h2>
      <% if (dish.ingredients.length === 0) { %>
        <p class="text-sm text-stone-400">Chưa có nguyên liệu. Bấm "Sửa" để thêm công thức.</p>
      <% } else { %>
        <ul class="grid gap-2 sm:grid-cols-2">
          <% dish.ingredients.forEach(function (di) { %>
            <li>
              <a href="/admin/ingredients/<%= di.ingredient.id %>" class="flex items-center justify-between rounded-lg bg-stone-50 px-3 py-2 text-sm hover:bg-brand-50">
                <span><%= di.ingredient.name %></span>
                <span class="font-semibold text-stone-700"><%= formatQty(di.quantity) %> <%= di.ingredient.unit %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="flex flex-wrap gap-3 border-t border-stone-100 px-6 py-4">
      <a href="/admin/dishes/<%= dish.id %>/edit" class="rounded-xl bg-brand-600 px-5 py-2.5 font-semibold text-white hover:bg-brand-700">Sửa</a>
      <a href="/admin/dishes/<%= dish.id %>/delete" class="rounded-xl bg-red-600 px-5 py-2.5 font-semibold text-white hover:bg-red-700">Xóa</a>
      <a href="/admin/dishes" class="rounded-xl border border-stone-300 px-5 py-2.5 font-semibold hover:bg-stone-100">Quay lại danh sách</a>
      <a href="/dishes/<%= dish.id %>" class="ml-auto rounded-xl px-5 py-2.5 font-medium text-stone-500 hover:text-brand-700">Xem trang khách →</a>
    </div>
  </div>
</div>

<%- include("../../partials/footer") %>
