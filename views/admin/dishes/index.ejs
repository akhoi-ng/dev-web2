<%- include("../../partials/header") %>

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Quản lý món ăn</h1>
    <p class="mt-1 text-stone-500"><%= total %> món trong thực đơn<% if (totalPages > 1) { %> · Trang <%= page %>/<%= totalPages %><% } %></p>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <form method="GET" action="/admin/dishes" class="flex items-center gap-2">
      <label for="sort" class="text-sm font-medium text-stone-500">Sắp xếp theo</label>
      <select id="sort" name="sort" onchange="this.form.submit()"
              class="rounded-xl border-0 bg-white py-2 pl-3 pr-8 text-sm font-semibold text-stone-700 ring-1 ring-stone-200 focus:ring-2 focus:ring-brand-400">
        <% Object.keys(sorts).forEach(function (key) { %>
          <option value="<%= key %>" <%= key === sort ? "selected" : "" %>><%= sorts[key].label %></option>
        <% }) %>
      </select>
      <noscript><button type="submit" class="rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">Áp dụng</button></noscript>
    </form>
    <a href="/admin/dishes/new" class="rounded-xl bg-brand-600 px-5 py-2.5 font-semibold text-white hover:bg-brand-700">+ Thêm mới</a>
  </div>
</div>

<div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-stone-200">
  <table class="rtable w-full text-left text-sm md:min-w-[900px]">
    <thead class="bg-stone-50 text-xs uppercase tracking-wide text-stone-500">
      <tr>
        <th class="px-4 py-3">ID</th>
        <th class="px-4 py-3">Món ăn</th>
        <th class="px-4 py-3">Danh mục</th>
        <th class="px-4 py-3">Đầu bếp</th>
        <th class="px-4 py-3 text-center">Nguyên liệu</th>
        <th class="px-4 py-3 text-right">Giá</th>
        <th class="px-4 py-3">Trạng thái</th>
        <th class="px-4 py-3 text-right">Thao tác</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-stone-100">
      <% if (dishes.length === 0) { %>
        <tr><td colspan="8" class="px-4 py-10 text-center text-stone-500">Chưa có món ăn nào.</td></tr>
      <% } %>
      <% dishes.forEach(function (d) { %>
        <tr class="hover:bg-cream">
          <td class="px-4 py-3 text-stone-400" data-label="ID">#<%= d.id %></td>
          <td class="rt-title px-4 py-3">
            <a href="/admin/dishes/<%= d.id %>" class="flex items-center gap-3 font-semibold hover:text-brand-700">
              <img src="<%= d.imageUrl || DEFAULT_DISH_IMAGE %>" alt="" class="h-11 w-11 rounded-lg object-cover">
              <%= d.name %>
            </a>
          </td>
          <td class="px-4 py-3 text-stone-600" data-label="Danh mục"><%= d.category || "—" %></td>
          <td class="px-4 py-3" data-label="Đầu bếp">
            <% if (d.chef) { %>
              <a href="/admin/chefs/<%= d.chef.id %>" class="text-stone-700 hover:text-brand-700"><%= d.chef.name %></a>
            <% } else { %>
              <span class="text-stone-400">Chưa phân công</span>
            <% } %>
          </td>
          <td class="px-4 py-3 text-center text-stone-600" data-label="Nguyên liệu"><%= d._count.ingredients %></td>
          <td class="px-4 py-3 text-right font-semibold" data-label="Giá"><%= formatPrice(d.price) %></td>
          <td class="px-4 py-3" data-label="Trạng thái">
            <% if (d.available) { %>
              <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700">Còn món</span>
            <% } else { %>
              <span class="rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-700">Hết món</span>
            <% } %>
          </td>
          <td class="rt-actions whitespace-nowrap px-4 py-3 text-right">
            <a href="/admin/dishes/<%= d.id %>/edit" class="rounded-lg px-3 py-1.5 font-medium text-brand-700 hover:bg-brand-50">Sửa</a>
            <a href="/admin/dishes/<%= d.id %>/delete" class="rounded-lg px-3 py-1.5 font-medium text-red-600 hover:bg-red-50">Xóa</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include("../../partials/pagination", {
  page,
  totalPages,
  // Giữ kiểu sắp xếp khi chuyển trang
  pageHref: function (p) {
    const params = [];
    if (sort !== "default") params.push("sort=" + encodeURIComponent(sort));
    if (p > 1) params.push("page=" + p);
    return "/admin/dishes" + (params.length ? "?" + params.join("&") : "");
  },
}) %>

<%- include("../../partials/footer") %>
