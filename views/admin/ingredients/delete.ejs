<%- include("../../partials/header") %>

<div class="mx-auto max-w-xl">
  <%- include("../../partials/page-heading", {
    heading: "Xác nhận xóa nguyên liệu",
    back: { href: "/admin/ingredients", label: "Danh sách nguyên liệu" }
  }) %>

  <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-red-200">
    <div class="p-6">
      <p class="text-xs text-stone-400">#<%= ingredient.id %></p>
      <p class="text-lg font-bold"><%= ingredient.name %></p>
      <p class="text-stone-600">Đơn vị tính: <%= ingredient.unit %></p>
    </div>

    <div class="border-t border-red-100 bg-red-50 px-6 py-4 text-sm text-red-700">
      Bạn có chắc muốn xóa nguyên liệu <strong><%= ingredient.name %></strong>? Thao tác này không thể hoàn tác.
      <% if (ingredient._count.dishes > 0) { %>
        <br>Nguyên liệu đang có trong công thức của <strong><%= ingredient._count.dishes %> món</strong> và sẽ bị gỡ khỏi các công thức đó (món ăn không bị xóa).
      <% } %>
    </div>

    <div class="flex flex-wrap gap-3 px-6 py-4">
      <form method="POST" action="/admin/ingredients/<%= ingredient.id %>?_method=DELETE">
        <button type="submit" class="rounded-xl bg-red-600 px-5 py-2.5 font-semibold text-white hover:bg-red-700">Xác nhận xóa</button>
      </form>
      <a href="/admin/ingredients" class="rounded-xl border border-stone-300 px-5 py-2.5 font-semibold hover:bg-stone-100">Hủy</a>
    </div>
  </div>
</div>

<%- include("../../partials/footer") %>
