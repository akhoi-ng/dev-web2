<%- include("../../partials/header") %>

<div class="mx-auto max-w-2xl">
  <%- include("../../partials/page-heading", {
    heading: ingredient.name,
    subheading: "Nguyên liệu #" + ingredient.id,
    back: { href: "/admin/ingredients", label: "Danh sách nguyên liệu" }
  }) %>

  <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-stone-200">
    <dl class="divide-y divide-stone-100 text-sm">
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">Tên nguyên liệu</dt><dd class="sm:col-span-2 font-semibold"><%= ingredient.name %></dd></div>
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">Đơn vị tính</dt><dd class="sm:col-span-2"><%= ingredient.unit %></dd></div>
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">Ngày tạo</dt><dd class="sm:col-span-2"><%= ingredient.createdAt.toLocaleString("vi-VN") %></dd></div>
    </dl>

    <div class="border-t border-stone-100 px-6 py-4">
      <h2 class="mb-3 text-sm font-semibold">Dùng trong · <%= ingredient.dishes.length %> món</h2>
      <% if (ingredient.dishes.length === 0) { %>
        <p class="text-sm text-stone-400">Chưa có món nào dùng nguyên liệu này. Thêm vào công thức trong form sửa món ăn.</p>
      <% } else { %>
        <ul class="grid gap-2 sm:grid-cols-2">
          <% ingredient.dishes.forEach(function (di) { %>
            <li>
              <a href="/admin/dishes/<%= di.dish.id %>" class="flex items-center gap-3 rounded-lg bg-stone-50 p-2 text-sm hover:bg-brand-50">
                <img src="<%= di.dish.imageUrl || DEFAULT_DISH_IMAGE %>" alt="" class="h-10 w-10 rounded-md object-cover">
                <span class="flex-1 font-medium"><%= di.dish.name %></span>
                <span class="font-semibold text-stone-700"><%= formatQty(di.quantity) %> <%= ingredient.unit %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="flex flex-wrap gap-3 border-t border-stone-100 px-6 py-4">
      <a href="/admin/ingredients/<%= ingredient.id %>/edit" class="rounded-xl bg-brand-600 px-5 py-2.5 font-semibold text-white hover:bg-brand-700">Sửa</a>
      <a href="/admin/ingredients/<%= ingredient.id %>/delete" class="rounded-xl bg-red-600 px-5 py-2.5 font-semibold text-white hover:bg-red-700">Xóa</a>
      <a href="/admin/ingredients" class="rounded-xl border border-stone-300 px-5 py-2.5 font-semibold hover:bg-stone-100">Quay lại danh sách</a>
    </div>
  </div>
</div>

<%- include("../../partials/footer") %>
