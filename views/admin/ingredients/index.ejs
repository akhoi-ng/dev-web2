<%- include("../../partials/header") %>

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Quản lý nguyên liệu</h1>
    <p class="mt-1 text-stone-500"><%= total %> nguyên liệu trong kho<% if (totalPages > 1) { %> · Trang <%= page %>/<%= totalPages %><% } %></p>
  </div>
  <a href="/admin/ingredients/new" class="rounded-xl bg-brand-600 px-5 py-2.5 font-semibold text-white hover:bg-brand-700">+ Thêm mới</a>
</div>

<div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-stone-200">
  <table class="rtable w-full text-left text-sm md:min-w-[560px]">
    <thead class="bg-stone-50 text-xs uppercase tracking-wide text-stone-500">
      <tr>
        <th class="px-4 py-3">ID</th>
        <th class="px-4 py-3">Nguyên liệu</th>
        <th class="px-4 py-3">Đơn vị</th>
        <th class="px-4 py-3 text-center">Dùng trong</th>
        <th class="px-4 py-3">Ngày tạo</th>
        <th class="px-4 py-3 text-right">Thao tác</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-stone-100">
      <% if (ingredients.length === 0) { %>
        <tr><td colspan="6" class="px-4 py-10 text-center text-stone-500">Chưa có nguyên liệu nào.</td></tr>
      <% } %>
      <% ingredients.forEach(function (i) { %>
        <tr class="hover:bg-cream">
          <td class="px-4 py-3 text-stone-400" data-label="ID">#<%= i.id %></td>
          <td class="rt-title px-4 py-3">
            <a href="/admin/ingredients/<%= i.id %>" class="font-semibold hover:text-brand-700"><%= i.name %></a>
          </td>
          <td class="px-4 py-3" data-label="Đơn vị">
            <span class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-semibold text-stone-700"><%= i.unit %></span>
          </td>
          <td class="px-4 py-3 text-center text-stone-600" data-label="Dùng trong"><%= i._count.dishes %> món</td>
          <td class="px-4 py-3 text-stone-500" data-label="Ngày tạo"><%= i.createdAt.toLocaleDateString("vi-VN") %></td>
          <td class="rt-actions whitespace-nowrap px-4 py-3 text-right">
            <a href="/admin/ingredients/<%= i.id %>/edit" class="rounded-lg px-3 py-1.5 font-medium text-brand-700 hover:bg-brand-50">Sửa</a>
            <a href="/admin/ingredients/<%= i.id %>/delete" class="rounded-lg px-3 py-1.5 font-medium text-red-600 hover:bg-red-50">Xóa</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include("../../partials/pagination", {
  page,
  totalPages,
  pageHref: function (p) { return p > 1 ? "/admin/ingredients?page=" + p : "/admin/ingredients"; },
}) %>

<%- include("../../partials/footer") %>
