<%
  // Biến nhận vào: action, values, errors, units, submitLabel, cancelHref
  const input = "mt-1 w-full rounded-xl border border-stone-300 px-4 py-2.5 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200";
%>
<%- include("../../partials/form-errors", { errors }) %>

<form method="POST" action="<%= action %>" class="space-y-5 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-stone-200 sm:p-8">
  <div>
    <label for="name" class="text-sm font-semibold">Tên nguyên liệu <span class="text-red-500">*</span></label>
    <input id="name" name="name" type="text" value="<%= values.name %>" maxlength="100" class="<%= input %>" placeholder="VD: Thăn bò Wagyu">
  </div>

  <div>
    <label for="unit" class="text-sm font-semibold">Đơn vị tính <span class="text-red-500">*</span></label>
    <input id="unit" name="unit" type="text" value="<%= values.unit %>" maxlength="20" list="unit-options" class="<%= input %>" placeholder="VD: kg">
    <datalist id="unit-options">
      <% units.forEach(function (u) { %>
        <option value="<%= u %>"></option>
      <% }) %>
    </datalist>
    <p class="mt-1 text-xs text-stone-500">Gợi ý: <%= units.join(", ") %></p>
  </div>

  <div class="flex flex-wrap gap-3 border-t border-stone-100 pt-5">
    <button type="submit" class="rounded-xl bg-brand-600 px-6 py-2.5 font-semibold text-white hover:bg-brand-700"><%= submitLabel %></button>
    <a href="<%= cancelHref %>" class="rounded-xl border border-stone-300 px-6 py-2.5 font-semibold hover:bg-stone-100">Hủy</a>
  </div>
</form>
