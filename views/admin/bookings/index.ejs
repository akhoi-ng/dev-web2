<%- include("../../partials/header") %>

<%
  const badge = {
    pending: "bg-saffron/25 text-[#6B4410]",
    confirmed: "bg-[#E3EFE7] text-[#1E5233]",
    cancelled: "bg-stone-200 text-stone-600",
  };
  // Nút đổi trạng thái hiện cho mỗi trạng thái hiện tại
  const actions = {
    pending: [{ to: "confirmed", label: "Xác nhận", cls: "bg-brand-600 text-white hover:bg-brand-700" }, { to: "cancelled", label: "Hủy", cls: "text-stone-600 hover:bg-stone-100" }],
    confirmed: [{ to: "cancelled", label: "Hủy", cls: "text-stone-600 hover:bg-stone-100" }],
    cancelled: [{ to: "pending", label: "Mở lại", cls: "text-brand-700 hover:bg-brand-50" }],
  };
%>

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Đặt bàn</h1>
    <p class="mt-1 text-stone-500"><%= bookings.length %> yêu cầu <%= showAll ? "(tất cả)" : "từ hôm nay trở đi" %></p>
  </div>
  <a href="/admin/bookings<%= showAll ? '' : '?show=all' %>" class="rounded-xl border border-stone-300 bg-white px-4 py-2.5 text-sm font-semibold hover:bg-stone-100">
    <%= showAll ? "Chỉ hiện lịch sắp tới" : "Hiện cả lịch đã qua" %>
  </a>
</div>

<%- include("../../partials/form-errors", { errors }) %>

<div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-stone-200">
  <table class="rtable w-full text-left text-sm md:min-w-[860px]">
    <thead class="bg-stone-50 text-xs uppercase tracking-wide text-stone-500">
      <tr>
        <th class="px-4 py-3">Thời gian</th>
        <th class="px-4 py-3">Khách</th>
        <th class="px-4 py-3">Điện thoại</th>
        <th class="px-4 py-3 text-center">Số người</th>
        <th class="px-4 py-3">Ghi chú</th>
        <th class="px-4 py-3">Trạng thái</th>
        <th class="px-4 py-3 text-right">Thao tác</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-stone-100">
      <% if (bookings.length === 0) { %>
        <tr><td colspan="7" class="px-4 py-10 text-center text-stone-500">Chưa có yêu cầu đặt bàn nào.</td></tr>
      <% } %>
      <% bookings.forEach(function (b) { %>
        <tr class="hover:bg-cream <%= b.status === 'cancelled' ? 'text-stone-400' : '' %>">
          <td class="rt-title px-4 py-3 font-semibold md:whitespace-nowrap"><%= formatDateTime(b.bookedAt) %></td>
          <td class="px-4 py-3" data-label="Khách"><span><%= b.name %><span class="block font-mono text-xs text-stone-400"><%= b.code.toUpperCase() %></span></span></td>
          <td class="whitespace-nowrap px-4 py-3" data-label="Điện thoại"><a href="tel:<%= b.phone %>" class="font-semibold text-brand-700 hover:underline md:font-normal md:text-ink"><%= formatPhone(b.phone) %></a></td>
          <td class="px-4 py-3 md:text-center" data-label="Số người"><%= b.guests %></td>
          <td class="px-4 py-3 text-stone-600 md:max-w-[220px]" data-label="Ghi chú"><%= b.note || "—" %></td>
          <td class="px-4 py-3" data-label="Trạng thái"><span class="whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold <%= badge[b.status] || '' %>"><%= statuses[b.status] || b.status %></span></td>
          <td class="rt-actions whitespace-nowrap px-4 py-3 text-right">
            <% (actions[b.status] || []).forEach(function (a) { %>
              <form method="POST" action="/admin/bookings/<%= b.id %>?_method=PATCH" class="inline">
                <input type="hidden" name="status" value="<%= a.to %>">
                <button type="submit" class="rounded-lg px-3 py-1.5 font-semibold <%= a.cls %>"><%= a.label %></button>
              </form>
            <% }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include("../../partials/footer") %>
