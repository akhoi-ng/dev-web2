<%- include("../../partials/header") %>

<div class="mx-auto max-w-xl">
  <%- include("../../partials/page-heading", {
    heading: "Xác nhận xóa đầu bếp",
    back: { href: "/admin/chefs", label: "Danh sách đầu bếp" }
  }) %>

  <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-red-200">
    <div class="flex items-center gap-4 p-6">
      <%- include("../../partials/chef-avatar", { chef, size: "h-20 w-20", textSize: "text-2xl" }) %>
      <div>
        <p class="text-xs text-stone-400">#<%= chef.id %></p>
        <p class="text-lg font-bold"><%= chef.name %></p>
        <p class="text-brand-700"><%= chef.specialty %></p>
      </div>
    </div>

    <div class="border-t border-red-100 bg-red-50 px-6 py-4 text-sm text-red-700">
      Bạn có chắc muốn xóa đầu bếp <strong><%= chef.name %></strong>? Thao tác này không thể hoàn tác.
      <% if (chef._count.dishes > 0) { %>
        <br><strong><%= chef._count.dishes %> món</strong> đang do đầu bếp này phụ trách sẽ chuyển thành "Chưa phân công" (món ăn không bị xóa).
      <% } %>
    </div>

    <div class="flex flex-wrap gap-3 px-6 py-4">
      <form method="POST" action="/admin/chefs/<%= chef.id %>?_method=DELETE">
        <button type="submit" class="rounded-xl bg-red-600 px-5 py-2.5 font-semibold text-white hover:bg-red-700">Xác nhận xóa</button>
      </form>
      <a href="/admin/chefs" class="rounded-xl border border-stone-300 px-5 py-2.5 font-semibold hover:bg-stone-100">Hủy</a>
    </div>
  </div>
</div>

<%- include("../../partials/footer") %>
