<%- include("../../partials/header") %>

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Quản lý đầu bếp</h1>
    <p class="mt-1 text-stone-500"><%= total %> đầu bếp trong đội ngũ<% if (totalPages > 1) { %> · Trang <%= page %>/<%= totalPages %><% } %></p>
  </div>
  <a href="/admin/chefs/new" class="rounded-xl bg-brand-600 px-5 py-2.5 font-semibold text-white hover:bg-brand-700">+ Thêm mới</a>
</div>

<div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-stone-200">
  <table class="rtable w-full text-left text-sm md:min-w-[600px]">
    <thead class="bg-stone-50 text-xs uppercase tracking-wide text-stone-500">
      <tr>
        <th class="px-4 py-3">ID</th>
        <th class="px-4 py-3">Đầu bếp</th>
        <th class="px-4 py-3">Chuyên môn</th>
        <th class="px-4 py-3 text-center">Món phụ trách</th>
        <th class="px-4 py-3 text-right">Thao tác</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-stone-100">
      <% if (chefs.length === 0) { %>
        <tr><td colspan="5" class="px-4 py-10 text-center text-stone-500">Chưa có đầu bếp nào.</td></tr>
      <% } %>
      <% chefs.forEach(function (c) { %>
        <tr class="hover:bg-cream">
          <td class="px-4 py-3 text-stone-400" data-label="ID">#<%= c.id %></td>
          <td class="rt-title px-4 py-3">
            <a href="/admin/chefs/<%= c.id %>" class="flex items-center gap-3 font-semibold hover:text-brand-700">
              <%- include("../../partials/chef-avatar", { chef: c, size: "h-11 w-11" }) %>
              <%= c.name %>
            </a>
          </td>
          <td class="px-4 py-3 text-stone-600" data-label="Chuyên môn"><%= c.specialty %></td>
          <td class="px-4 py-3 text-center text-stone-600" data-label="Món phụ trách"><%= c._count.dishes %></td>
          <td class="rt-actions whitespace-nowrap px-4 py-3 text-right">
            <a href="/admin/chefs/<%= c.id %>/edit" class="rounded-lg px-3 py-1.5 font-medium text-brand-700 hover:bg-brand-50">Sửa</a>
            <a href="/admin/chefs/<%= c.id %>/delete" class="rounded-lg px-3 py-1.5 font-medium text-red-600 hover:bg-red-50">Xóa</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include("../../partials/pagination", {
  page,
  totalPages,
  pageHref: function (p) { return p > 1 ? "/admin/chefs?page=" + p : "/admin/chefs"; },
}) %>

<%- include("../../partials/footer") %>
