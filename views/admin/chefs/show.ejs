<%- include("../../partials/header") %>

<div class="mx-auto max-w-2xl">
  <%- include("../../partials/page-heading", {
    heading: chef.name,
    subheading: "Đầu bếp #" + chef.id,
    back: { href: "/admin/chefs", label: "Danh sách đầu bếp" }
  }) %>

  <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-stone-200">
    <div class="flex flex-col items-center gap-3 bg-gradient-to-br from-brand-50 to-stone-100 px-6 py-8 text-center">
      <%- include("../../partials/chef-avatar", { chef, size: "h-32 w-32", textSize: "text-4xl" }) %>
      <div>
        <p class="text-xl font-bold"><%= chef.name %></p>
        <p class="text-brand-700"><%= chef.specialty %></p>
      </div>
    </div>

    <dl class="divide-y divide-stone-100 text-sm">
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">Họ tên</dt><dd class="sm:col-span-2 font-semibold"><%= chef.name %></dd></div>
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">Chuyên môn</dt><dd class="sm:col-span-2"><%= chef.specialty %></dd></div>
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">URL ảnh</dt><dd class="sm:col-span-2 break-all text-stone-500"><%= chef.imageUrl || "(chưa có ảnh)" %></dd></div>
      <div class="grid gap-1 px-6 py-3 sm:grid-cols-3 sm:gap-4"><dt class="text-stone-500">Ngày tạo</dt><dd class="sm:col-span-2"><%= chef.createdAt.toLocaleString("vi-VN") %></dd></div>
    </dl>

    <div class="border-t border-stone-100 px-6 py-4">
      <h2 class="mb-3 text-sm font-semibold">Món phụ trách · <%= chef.dishes.length %> món</h2>
      <% if (chef.dishes.length === 0) { %>
        <p class="text-sm text-stone-400">Chưa phụ trách món nào. Gán đầu bếp trong form sửa món ăn.</p>
      <% } else { %>
        <ul class="grid gap-2 sm:grid-cols-2">
          <% chef.dishes.forEach(function (d) { %>
            <li>
              <a href="/admin/dishes/<%= d.id %>" class="flex items-center gap-3 rounded-lg bg-stone-50 p-2 text-sm hover:bg-brand-50">
                <img src="<%= d.imageUrl || DEFAULT_DISH_IMAGE %>" alt="" class="h-10 w-10 rounded-md object-cover">
                <span class="flex-1 font-medium"><%= d.name %></span>
                <span class="text-xs text-stone-500"><%= d.category || "" %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="flex flex-wrap gap-3 border-t border-stone-100 px-6 py-4">
      <a href="/admin/chefs/<%= chef.id %>/edit" class="rounded-xl bg-brand-600 px-5 py-2.5 font-semibold text-white hover:bg-brand-700">Sửa</a>
      <a href="/admin/chefs/<%= chef.id %>/delete" class="rounded-xl bg-red-600 px-5 py-2.5 font-semibold text-white hover:bg-red-700">Xóa</a>
      <a href="/admin/chefs" class="rounded-xl border border-stone-300 px-5 py-2.5 font-semibold hover:bg-stone-100">Quay lại danh sách</a>
    </div>
  </div>
</div>

<%- include("../../partials/footer") %>
