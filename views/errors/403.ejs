<%#
  403: biết (hoặc chưa cần biết) người gọi nhưng yêu cầu không được phép.
  Biến tùy chọn: heading, message, code (mặc định là lỗi CSRF)
%>
<%
  const errCode = locals.code || "CSRF_FAILED";
  const errHeading = locals.heading || "Yêu cầu bị từ chối";
  const errMessage = locals.message || "Form đã hết hạn hoặc được gửi từ trang khác. Hãy tải lại trang rồi thử lại.";
%>
<%- include("../partials/header", { title: locals.title || "Yêu cầu bị từ chối" }) %>

<div class="mx-auto max-w-lg py-16 text-center" data-error-code="<%= errCode %>">
  <p class="text-7xl font-extrabold text-brand-600">403</p>
  <h1 class="mt-4 text-2xl font-bold"><%= errHeading %></h1>
  <p class="mt-2 text-stone-500"><%= errMessage %></p>
  <p class="mt-2 text-xs text-stone-400">Mã lỗi: <%= errCode %></p>
  <div class="mt-8 flex flex-wrap justify-center gap-3">
    <a href="/dishes" class="rounded-xl bg-brand-600 px-5 py-3 font-semibold text-white hover:bg-brand-700">Về thực đơn</a>
  </div>
</div>

<%- include("../partials/footer") %>
