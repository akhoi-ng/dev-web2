<%- include("../partials/header") %>

<div class="mx-auto max-w-xl">
  <div class="flex flex-col items-center gap-3 text-center">
    <span class="flex h-16 w-16 items-center justify-center rounded-full bg-[#E3EFE7]">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1E5233" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
    </span>
    <h1 class="text-3xl font-extrabold tracking-tight">Đã nhận yêu cầu đặt bàn</h1>
    <p class="text-stone-600">Nhà hàng sẽ gọi số <strong class="text-ink"><%= formatPhone(booking.phone) %></strong> để xác nhận. Lưu lại trang này để xem lại yêu cầu.</p>
  </div>

  <dl class="mt-8 divide-y divide-[#F3E8E1] rounded-3xl border border-[#EADBD2] bg-white px-6">
    <div class="flex justify-between gap-4 py-4"><dt class="text-stone-500">Mã đặt bàn</dt><dd class="font-mono text-lg font-bold tracking-wider"><%= booking.code.toUpperCase() %></dd></div>
    <div class="flex justify-between gap-4 py-4"><dt class="text-stone-500">Trạng thái</dt><dd class="font-semibold"><%= statuses[booking.status] || booking.status %></dd></div>
    <div class="flex justify-between gap-4 py-4"><dt class="text-stone-500">Thời gian</dt><dd class="text-right font-semibold"><%= formatDateTime(booking.bookedAt) %></dd></div>
    <div class="flex justify-between gap-4 py-4"><dt class="text-stone-500">Số khách</dt><dd class="font-semibold"><%= booking.guests %> người</dd></div>
    <div class="flex justify-between gap-4 py-4"><dt class="text-stone-500">Họ tên</dt><dd class="text-right font-semibold"><%= booking.name %></dd></div>
    <% if (booking.note) { %>
      <div class="flex flex-col gap-1 py-4"><dt class="text-stone-500">Ghi chú</dt><dd class="whitespace-pre-line"><%= booking.note %></dd></div>
    <% } %>
  </dl>

  <p class="mt-6 text-center text-sm text-stone-500">
    Cần đổi giờ hoặc hủy? Gọi <a href="tel:<%= RESTAURANT.phone %>" class="font-semibold text-brand-700 hover:underline"><%= formatPhone(RESTAURANT.phone) %></a> · <%= RESTAURANT.address %>
  </p>

  <div class="mt-8 flex justify-center">
    <a href="/dishes#thuc-don" class="rounded-2xl bg-ink px-6 py-3 font-bold text-white hover:bg-stone-700">Xem thực đơn trong lúc chờ</a>
  </div>
</div>

<%- include("../partials/footer") %>
