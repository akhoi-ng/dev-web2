<%- include("../partials/header") %>

<%
  const field = "mt-1.5 min-h-12 w-full rounded-xl border border-[#D9C3B7] bg-white px-4 text-base focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200";
  const label = "text-sm font-semibold";
%>

<nav aria-label="Vị trí trang" class="mb-6 flex flex-wrap gap-2 text-sm text-stone-500">
  <a href="/dishes" class="hover:text-brand-700">Trang chủ</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page" class="font-semibold text-ink">Đặt bàn</span>
</nav>

<!-- Điện thoại: tiêu đề ở trên, form ngay sau, thẻ thông tin xuống cuối -->
<div class="mb-6 md:hidden">
  <h1 class="text-3xl font-extrabold leading-tight tracking-tight">Đặt bàn trước, đến là có chỗ.</h1>
  <p class="mt-2 leading-relaxed text-stone-600">Gửi yêu cầu trong một phút. Nhà hàng sẽ gọi lại để xác nhận bàn cho bạn.</p>
</div>

<div class="flex flex-wrap items-start gap-6 md:gap-8">
  <!-- Thông tin nhà hàng -->
  <aside class="order-last flex min-w-0 flex-[1_1_300px] flex-col gap-6 rounded-3xl bg-brand-600 p-6 text-white sm:p-8 md:order-first">
    <div class="hidden md:block">
      <h1 class="text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">Đặt bàn trước,<br>đến là có chỗ.</h1>
      <p class="mt-3 leading-relaxed text-[#FFE9E1]">Gửi yêu cầu trong một phút. Nhà hàng sẽ gọi lại để xác nhận bàn cho bạn.</p>
    </div>

    <dl class="flex flex-col gap-4 rounded-2xl bg-white p-5 text-ink">
      <div class="flex items-start gap-3">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9A2816" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 flex-none"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
        <div>
          <dt class="text-sm text-stone-500">Hotline</dt>
          <dd><a href="tel:<%= RESTAURANT.phone %>" class="text-xl font-extrabold hover:text-brand-700"><%= formatPhone(RESTAURANT.phone) %></a></dd>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9A2816" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 flex-none"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <div>
          <dt class="text-sm text-stone-500">Địa chỉ</dt>
          <dd class="font-semibold"><%= RESTAURANT.address %></dd>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9A2816" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 flex-none"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
        <div>
          <dt class="text-sm text-stone-500">Giờ mở cửa</dt>
          <dd class="font-semibold"><%= RESTAURANT.hours %> mỗi ngày</dd>
        </div>
      </div>
    </dl>

    <p class="text-sm leading-relaxed text-[#FFE9E1]">Nhóm trên <%= maxGuests %> người, vui lòng gọi hotline để nhà hàng sắp xếp chỗ.</p>
  </aside>

  <!-- Form đặt bàn -->
  <div class="min-w-0 flex-[2_1_480px]">
    <%- include("../partials/form-errors", { errors }) %>

    <form method="POST" action="/bookings" class="flex flex-col gap-6 rounded-3xl border border-[#EADBD2] bg-white p-5 sm:p-8">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight">Thông tin đặt bàn</h2>
        <p class="mt-1 text-sm text-stone-500">Các ô có dấu <span class="text-brand-700">*</span> là bắt buộc.</p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="name" class="<%= label %>">Họ tên <span class="text-brand-700">*</span></label>
          <input id="name" name="name" type="text" value="<%= values.name %>" maxlength="100" required autocomplete="name"
                 placeholder="Nguyễn Văn A" class="<%= field %>">
        </div>

        <div>
          <label for="phone" class="<%= label %>">Số điện thoại <span class="text-brand-700">*</span></label>
          <input id="phone" name="phone" type="tel" value="<%= values.phone %>" required autocomplete="tel" inputmode="tel"
                 placeholder="0123 456 789" class="<%= field %>">
          <p class="mt-1 text-xs text-stone-500">Nhà hàng gọi số này để xác nhận.</p>
        </div>

        <div>
          <label for="guests" class="<%= label %>">Số khách <span class="text-brand-700">*</span></label>
          <select id="guests" name="guests" class="<%= field %>">
            <% for (let n = 1; n <= maxGuests; n++) { %>
              <option value="<%= n %>" <%= String(n) === values.guests ? "selected" : "" %>><%= n %> người</option>
            <% } %>
          </select>
        </div>

        <div class="sm:col-span-2">
          <label for="date" class="<%= label %>">Ngày đến <span class="text-brand-700">*</span></label>
          <input id="date" name="date" type="date" value="<%= values.date %>" min="<%= minDate %>" max="<%= maxDate %>" required
                 class="<%= field %> sm:max-w-xs">
        </div>
      </div>

      <fieldset>
        <legend class="<%= label %>">Giờ đến <span class="text-brand-700">*</span></legend>
        <div class="mt-2 grid grid-cols-3 gap-2 sm:grid-cols-4 lg:grid-cols-6">
          <% slots.forEach(function (t) { %>
            <label class="cursor-pointer">
              <input type="radio" name="time" value="<%= t %>" class="peer sr-only" <%= t === values.time ? "checked" : "" %> required>
              <span class="flex min-h-11 items-center justify-center rounded-xl border border-[#D9C3B7] bg-white text-[15px] font-semibold transition hover:border-brand-400 peer-checked:border-brand-600 peer-checked:bg-brand-600 peer-checked:text-white peer-focus-visible:outline peer-focus-visible:outline-[3px] peer-focus-visible:outline-offset-2 peer-focus-visible:outline-saffron"><%= t %></span>
            </label>
          <% }) %>
        </div>
      </fieldset>

      <div>
        <label for="note" class="<%= label %>">Ghi chú</label>
        <textarea id="note" name="note" rows="3" maxlength="500"
                  placeholder="VD: có trẻ nhỏ, cần ghế em bé, muốn ngồi gần cửa sổ…"
                  class="mt-1.5 w-full rounded-xl border border-[#D9C3B7] px-4 py-3 text-base focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"><%= values.note %></textarea>
      </div>

      <div class="flex flex-wrap items-center gap-4 border-t border-[#F3E8E1] pt-6">
        <button type="submit" class="min-h-12 w-full rounded-2xl bg-brand-600 px-8 text-base font-bold text-white hover:bg-brand-700 sm:w-auto">Gửi yêu cầu đặt bàn</button>
        <a href="/dishes" class="font-semibold text-stone-600 hover:text-brand-700">Quay lại thực đơn</a>
      </div>
    </form>
  </div>
</div>

<%- include("../partials/footer") %>
