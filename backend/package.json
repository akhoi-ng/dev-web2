{
  "name": "uniportal-backend",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"../node_modules/**\" --exclude \"./data/**\" src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "tsc --noEmit",
    "reset-data": "node -e \"require('fs').copyFileSync('data/students.seed.json','data/students.json')\""
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
