# Supabase > Project Settings > Database > Connection string
# Kết nối qua pooler (Transaction mode, cổng 6543) cho ứng dụng
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Kết nối trực tiếp (Session mode, cổng 5432) cho `prisma db push`
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
PORT=3000

# Origin của SPA được phép gọi API (không có dấu / ở cuối; nhiều origin cách nhau bằng dấu phẩy).
# Không dùng "*": cookie refresh token cần credentials, mà dấu sao không đi cùng credentials.
CORS_ORIGIN=http://localhost:5173
# Địa chỉ của SPA để dựng link đặt lại mật khẩu trong email (mặc định: origin đầu tiên của CORS_ORIGIN)
WEB_URL=http://localhost:5173

# In mọi câu SQL Prisma gửi tới PostgreSQL (dùng khi lấy bằng chứng truy vấn)
# LOG_SQL=1

# ── Block 9: xác thực bằng JWT ──
# Khóa HMAC cho hash OTP kích hoạt. PHẢI trùng SESSION_SECRET ở .env của bản SSR vì hai bản đọc
# chung bảng activation_challenges.
SESSION_SECRET=
# Khóa ký access token (HS256), ít nhất 32 ký tự, khác SESSION_SECRET. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Cookie refresh token: Secure bật mặc định (browser vẫn nhận trên http://localhost).
# COOKIE_SECURE=0 chỉ khi thử bằng công cụ HTTP không gửi cookie Secure qua http.
# COOKIE_SECURE=0
# SameSite của cookie refresh: strict (mặc định, web và api cùng site) | lax | none (khác site, cần HTTPS)
# REFRESH_COOKIE_SAMESITE=strict

# Chạy sau reverse proxy thì đặt 1 để lấy IP thật từ X-Forwarded-For (cho rate limit)
# TRUST_PROXY=1

# Tài khoản đã kích hoạt do `npm run db:seed-user` tạo
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Google reCAPTCHA v2 (checkbox). Domain đăng ký: localhost. Site key công khai (SPA lấy qua
# GET /api/auth/captcha), secret key chỉ ở đây.
# Test key của Google luôn thành công (KHÔNG dùng làm bằng chứng chặn bot):
#   RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
#   RECAPTCHA_HOSTNAMES=localhost,testkey.google.com
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Hostname chấp nhận trong kết quả siteverify (mặc định: hostname của WEB_URL)
# RECAPTCHA_HOSTNAMES=localhost

# Gửi email: file | resend | ethereal | smtp (giống bản SSR). file ghi thư vào api/mail-outbox/
MAIL_TRANSPORT=file
MAIL_FROM=
RESEND_API_KEY=
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
