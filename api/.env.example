# Supabase > Project Settings > Database > Connection string
# Kết nối qua pooler (Transaction mode, cổng 6543) cho ứng dụng
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Kết nối trực tiếp (Session mode, cổng 5432) cho `prisma db push`
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
PORT=3000

# Origin của SPA được phép gọi API (không có dấu / ở cuối; nhiều origin cách nhau bằng dấu phẩy)
CORS_ORIGIN=http://localhost:5173

# In mọi câu SQL Prisma gửi tới PostgreSQL (dùng khi lấy bằng chứng truy vấn)
# LOG_SQL=1
