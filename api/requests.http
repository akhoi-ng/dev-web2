# Thử API bằng REST Client (VS Code). Chạy API trước: npm run dev
@api = http://localhost:3000
@origin = http://localhost:5173

### Danh sách món (không phân trang)
# @name dishList
GET {{api}}/api/dishes
Origin: {{origin}}

### Danh sách món có phân trang, lọc, sắp xếp
GET {{api}}/api/dishes?page=1&pageSize=9&category=Khai vị&sort=price-asc
Origin: {{origin}}

### page không hợp lệ -> trang 1
GET {{api}}/api/dishes?page=abc
Origin: {{origin}}

### q là mảng và danh mục lạ -> bị bỏ qua
GET {{api}}/api/dishes?q[]=x&category=xyz
Origin: {{origin}}

### Chi tiết món đầu tiên trong danh sách (gửi "Danh sách món" trước)
GET {{api}}/api/dishes/{{dishList.response.body.data[0].id}}
Origin: {{origin}}

### Không tồn tại -> NOT_FOUND (HTTP 200, ok: false)
GET {{api}}/api/dishes/999999
Origin: {{origin}}

### id không phải số -> NOT_FOUND
GET {{api}}/api/dishes/abc
Origin: {{origin}}

### Tạo món sai -> VALIDATION_FAILED (name, price)
POST {{api}}/api/dishes
Origin: {{origin}}
Content-Type: application/json

{ "name": "", "price": -5 }

### Giá là chuỗi -> VALIDATION_FAILED (price)
POST {{api}}/api/dishes
Origin: {{origin}}
Content-Type: application/json

{ "name": "Test", "price": "50000" }

### Tạo món hợp lệ (gửi dòng này trước khi chạy PATCH/DELETE bên dưới)
# @name createdDish
POST {{api}}/api/dishes
Origin: {{origin}}
Content-Type: application/json

{ "name": "Món thử", "price": 50000, "category": "Món chính" }

### Sửa một phần món vừa tạo
PATCH {{api}}/api/dishes/{{createdDish.response.body.data.id}}
Origin: {{origin}}
Content-Type: application/json

{ "price": 60000 }

### Sửa món không tồn tại -> NOT_FOUND
PATCH {{api}}/api/dishes/999999
Origin: {{origin}}
Content-Type: application/json

{ "price": 60000 }

### Sửa với tên rỗng -> VALIDATION_FAILED
PATCH {{api}}/api/dishes/{{createdDish.response.body.data.id}}
Origin: {{origin}}
Content-Type: application/json

{ "name": "" }

### Xóa món vừa tạo
DELETE {{api}}/api/dishes/{{createdDish.response.body.data.id}}
Origin: {{origin}}

### Xóa lại món đã xóa -> NOT_FOUND
DELETE {{api}}/api/dishes/{{createdDish.response.body.data.id}}
Origin: {{origin}}

### ---------- Đầu bếp ----------

### Danh sách đầu bếp (không phân trang)
GET {{api}}/api/chefs
Origin: {{origin}}

### Danh sách đầu bếp có phân trang
GET {{api}}/api/chefs?page=1&pageSize=2
Origin: {{origin}}

### Không tồn tại -> NOT_FOUND
GET {{api}}/api/chefs/999999
Origin: {{origin}}

### Tạo đầu bếp sai -> VALIDATION_FAILED (name, specialty)
POST {{api}}/api/chefs
Origin: {{origin}}
Content-Type: application/json

{ "name": "", "specialty": "" }

### Tạo đầu bếp hợp lệ (gửi dòng này trước khi chạy các dòng bên dưới)
# @name createdChef
POST {{api}}/api/chefs
Origin: {{origin}}
Content-Type: application/json

{ "name": "Đầu bếp thử", "specialty": "Món thử" }

### Chi tiết đầu bếp vừa tạo
GET {{api}}/api/chefs/{{createdChef.response.body.data.id}}
Origin: {{origin}}

### Sửa một phần đầu bếp vừa tạo
PATCH {{api}}/api/chefs/{{createdChef.response.body.data.id}}
Origin: {{origin}}
Content-Type: application/json

{ "specialty": "Món thử đã sửa" }

### Sửa đầu bếp với tên rỗng -> VALIDATION_FAILED
PATCH {{api}}/api/chefs/{{createdChef.response.body.data.id}}
Origin: {{origin}}
Content-Type: application/json

{ "name": "" }

### Xóa đầu bếp vừa tạo (món của họ còn lại, chef = null)
DELETE {{api}}/api/chefs/{{createdChef.response.body.data.id}}
Origin: {{origin}}

### Xóa lại đầu bếp đã xóa -> NOT_FOUND
DELETE {{api}}/api/chefs/{{createdChef.response.body.data.id}}
Origin: {{origin}}

### ---------- Nguyên liệu ----------

### Danh sách nguyên liệu (không phân trang)
GET {{api}}/api/ingredients
Origin: {{origin}}

### Danh sách nguyên liệu có phân trang
GET {{api}}/api/ingredients?page=1&pageSize=5
Origin: {{origin}}

### Không tồn tại -> NOT_FOUND
GET {{api}}/api/ingredients/999999
Origin: {{origin}}

### Tạo nguyên liệu sai -> VALIDATION_FAILED (name, unit)
POST {{api}}/api/ingredients
Origin: {{origin}}
Content-Type: application/json

{ "name": "", "unit": "" }

### Tạo nguyên liệu hợp lệ (gửi dòng này trước khi chạy các dòng bên dưới)
# @name createdIngredient
POST {{api}}/api/ingredients
Origin: {{origin}}
Content-Type: application/json

{ "name": "Nguyên liệu thử", "unit": "g" }

### Chi tiết nguyên liệu vừa tạo
GET {{api}}/api/ingredients/{{createdIngredient.response.body.data.id}}
Origin: {{origin}}

### Sửa một phần nguyên liệu vừa tạo
PATCH {{api}}/api/ingredients/{{createdIngredient.response.body.data.id}}
Origin: {{origin}}
Content-Type: application/json

{ "unit": "kg" }

### Sửa nguyên liệu với đơn vị rỗng -> VALIDATION_FAILED
PATCH {{api}}/api/ingredients/{{createdIngredient.response.body.data.id}}
Origin: {{origin}}
Content-Type: application/json

{ "unit": "" }

### Xóa nguyên liệu vừa tạo
DELETE {{api}}/api/ingredients/{{createdIngredient.response.body.data.id}}
Origin: {{origin}}

### Xóa lại nguyên liệu đã xóa -> NOT_FOUND
DELETE {{api}}/api/ingredients/{{createdIngredient.response.body.data.id}}
Origin: {{origin}}

### ---------- Khác ----------

### Route không tồn tại -> HTTP 404 {message}
GET {{api}}/api/bok
Origin: {{origin}}

### Thống kê thực đơn
GET {{api}}/api/stats
Origin: {{origin}}

### Tùy chọn cho form và bộ lọc
GET {{api}}/api/options
Origin: {{origin}}

### Preflight CORS cho PATCH -> 204 kèm đúng origin
OPTIONS {{api}}/api/dishes/1
Origin: {{origin}}
Access-Control-Request-Method: PATCH
Access-Control-Request-Headers: content-type
