{
  "name": "restaurant-manager",
  "version": "1.0.0",
  "description": "Quản lý Nhà hàng - Express + EJS + Prisma (SSR)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
