{
  "name": "restaurant-manager",
  "version": "1.0.0",
  "description": "Quản lý Nhà hàng - Express + EJS + Prisma (SSR) + xác thực session",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "acceptance": "node scripts/acceptance.mjs",
    "db:push": "prisma db push",
    "db:search": "prisma db execute --file prisma/search.sql --schema prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "db:seed-user": "node prisma/seed-user.js",
    "db:cleanup": "node src/auth/cleanup.js",
    "postinstall": "prisma generate",
    "mail:test": "node src/auth/mailer.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.16.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "method-override": "^3.0.0",
    "nodemailer": "^10.3.1",
    "resend": "^6.37.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "prisma": "^6.16.0"
  }
}
