# Photo Gallery server - copy thành .env rồi điền giá trị. KHÔNG commit file .env.
# Biến đã đặt sẵn trong môi trường (shell, Docker, CI) được ưu tiên hơn giá trị trong file này.

NODE_ENV=development
PORT=4000
# Chạy sau reverse proxy / CDN: số proxy tin cậy để lấy IP thật (rate limit đăng nhập)
# TRUST_PROXY=1

# ── Database (PostgreSQL) ──
# ?schema=gallery: bảng nằm trong schema riêng, không đụng bảng của ứng dụng khác trong cùng DB.
# Supabase: DATABASE_URL dùng pooler Transaction (cổng 6543) kèm &pgbouncer=true,
#           DIRECT_URL dùng Session/Direct (cổng 5432) cho `npm run db:migrate`.
DATABASE_URL=postgresql://gallery:gallery@localhost:5432/gallery?schema=gallery
DIRECT_URL=postgresql://gallery:gallery@localhost:5432/gallery?schema=gallery

# ── Xác thực admin ──
# Ít nhất 32 ký tự ngẫu nhiên:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_TTL_HOURS=12
# Mặc định bật khi NODE_ENV=production. Browser vẫn nhận cookie Secure trên http://localhost.
# COOKIE_SECURE=1
# Tài khoản admin đầu tiên (không có trang đăng ký). Tạo tự động khi DB chưa có user nào,
# hoặc chạy `npm run db:seed` để tạo/đặt lại mật khẩu.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Nơi lưu ảnh: NHIỀU kho, admin chọn kho khi upload ──
# STORAGE_PROFILES: danh sách tên kho (chữ thường, cách nhau dấu phẩy). Mỗi kho khai báo bằng các
# biến <TÊN>_..., ví dụ r2 -> R2_ENDPOINT. STORAGE_DEFAULT: kho dùng khi upload không chọn kho.
# Mỗi ảnh ghi tên kho của nó trong DB (cột storage). Ứng dụng không tự chuyển kho khi lỗi.
# Kho có <TÊN>_PUBLIC_BASE_URL -> browser tải ảnh thẳng từ đó (bucket phải cho đọc công khai);
# bỏ trống -> web server đọc từ bucket và phục vụ qua /media (bucket có thể private, ảnh ẩn bị chặn).
# Lấy key mới từ kho -> khởi động lại; file của kho cũ vẫn đọc được vì tên kho đã lưu trong DB.
STORAGE_PROFILES=r2,seaweedfs
STORAGE_DEFAULT=r2

# --- Cloudflare R2 ---
R2_LABEL=Cloudflare R2
R2_DRIVER=s3
R2_PROVIDER=r2
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=gallery
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=                        # vd https://pub-xxxxxxxx.r2.dev hoặc custom domain
R2_DOWNLOAD_MODE=presigned                 # proxy | presigned (URL có chữ ký 5 phút)

# --- SeaweedFS (S3 gateway; API và CDN có thể là hai domain khác nhau) ---
SEAWEEDFS_LABEL=SeaweedFS
SEAWEEDFS_DRIVER=s3
SEAWEEDFS_PROVIDER=seaweedfs
SEAWEEDFS_ENDPOINT=https://cdn.example.com # API dùng để ghi/xóa (hoặc http://10.0.0.5:8333)
SEAWEEDFS_REGION=us-east-1
SEAWEEDFS_BUCKET=cdn
SEAWEEDFS_ACCESS_KEY_ID=
SEAWEEDFS_SECRET_ACCESS_KEY=
SEAWEEDFS_FORCE_PATH_STYLE=true            # SeaweedFS dùng /bucket/key, không dùng subdomain
SEAWEEDFS_PUBLIC_BASE_URL=https://cdn.example.com/cdn
SEAWEEDFS_DOWNLOAD_MODE=presigned

# --- Mẫu kho thêm (bỏ comment và thêm tên vào STORAGE_PROFILES) ---
# AWS S3:      AWS_DRIVER=s3  AWS_PROVIDER=aws  AWS_REGION=ap-southeast-1  AWS_BUCKET=...
#              AWS_ACCESS_KEY_ID=  AWS_SECRET_ACCESS_KEY=  AWS_PUBLIC_BASE_URL=https://dxxxx.cloudfront.net
# MinIO:       MINIO_DRIVER=s3  MINIO_PROVIDER=minio  MINIO_ENDPOINT=http://10.0.0.6:9000  MINIO_BUCKET=gallery
#              MINIO_ACCESS_KEY_ID=  MINIO_SECRET_ACCESS_KEY=  MINIO_FORCE_PATH_STYLE=true
# Ổ đĩa server: LOCAL_DRIVER=local  LOCAL_ROOT=/srv/gallery-uploads   (đường dẫn tuyệt đối ngoài source code)

# URL công khai của media khi web server là origin (kho không có URL công khai). Mặc định /media.
# Đặt CDN phía trước origin thì đổi thành domain CDN, ví dụ https://cdn.example.com/media
# MEDIA_BASE_URL=/media

# ── Giới hạn upload (giá trị của đề bài) ──
UPLOAD_MAX_FILES=5
UPLOAD_MAX_FILE_BYTES=10485760
UPLOAD_MAX_REQUEST_BYTES=57671680
UPLOAD_MAX_PIXELS=40000000
# Chiều rộng:quality của từng variant WebP (tối đa 3 mức)
VARIANTS=320:75,960:82,1600:86
# Số ảnh sharp xử lý đồng thời trên toàn server
PROCESSING_CONCURRENCY=2
# Ảnh upload chỉ nằm trong RAM (không ghi file tạm ra đĩa); bộ nhớ mỗi request <= UPLOAD_MAX_REQUEST_BYTES

# ── Dọn file ──
# Chu kỳ chạy tác vụ dọn (ms); 0 = tắt, chỉ chạy tay bằng `npm run cleanup` hoặc nút trong Admin
CLEANUP_INTERVAL_MS=600000
# Khi DB cũng lỗi, key cần dọn được ghi vào file này rồi nạp lại vào DB ở lần dọn sau
# CLEANUP_JOURNAL_PATH=./data/cleanup-journal.ndjson

# ── Chỉ để nghiệm thu (bị bỏ qua khi NODE_ENV=production) ──
# db-commit      : DB lỗi sau khi đã ghi file -> phải xóa bù file vừa ghi
# storage-write  : ghi bản gốc vào kho lỗi -> phải xóa các variant đã ghi
# cleanup-delete : mọi thao tác xóa lỗi -> key được giữ trong storage_cleanups để dọn lại
# FAULT_INJECTION=

# In mọi câu SQL (lấy bằng chứng truy vấn)
# LOG_SQL=1
