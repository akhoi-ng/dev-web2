// Photo Gallery - schema PostgreSQL.
// Đặt `?schema=gallery` trong DATABASE_URL để các bảng nằm trong schema riêng.
//
// Nguyên tắc (đề Block 11):
//   - DB giữ tiêu đề, alt text, kích thước và STORAGE KEY. Không giữ bytes ảnh, đường dẫn tuyệt đối,
//     URL hay thông tin xác thực kết nối S3. URL được dựng lúc trả response từ storage key.
//   - Photo mô tả một mục trong gallery; PhotoVariant mô tả một file WebP đã sinh.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  // Tăng lên khi đổi mật khẩu để vô hiệu mọi phiên đang mở
  tokenVersion Int       @default(0) @map("token_version")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")
  photos       Photo[]

  @@map("users")
}

model Album {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  photos      Photo[]

  @@map("albums")
}

enum PhotoStatus {
  // Gallery công khai thấy ảnh
  PUBLISHED
  // Admin ẩn ảnh; file vẫn còn
  HIDDEN
  // Đã yêu cầu xóa: gallery không thấy, đang dọn file. Còn ở trạng thái này nghĩa là dọn file
  // chưa xong; các PhotoVariant còn lại chính là danh sách key để chạy dọn lại.
  DELETING

  @@map("photo_status")
}

model Photo {
  // Server tạo id sau khi file qua bước kiểm tra, trước khi ghi file vào kho
  id                String         @id @db.Uuid
  title             String
  altText           String         @map("alt_text")
  description       String?
  tags              String[]       @default([])
  albumId           String?        @map("album_id") @db.Uuid
  album             Album?         @relation(fields: [albumId], references: [id], onDelete: SetNull)
  status            PhotoStatus    @default(PUBLISHED)
  // Kích thước bản gốc đã chuẩn hóa (đã xoay theo EXIF orientation)
  width             Int
  height            Int
  // Thông tin file người dùng gửi: tên đã làm sạch (chỉ để hiển thị), định dạng theo chữ ký file
  sourceFilename    String         @map("source_filename")
  sourceFormat      String         @map("source_format")
  sourceBytes       Int            @map("source_bytes")
  // Tên kho lưu file của ảnh (một tên trong STORAGE_PROFILES, ví dụ "r2", "seaweedfs"). Không phải
  // thông tin xác thực: endpoint và key nằm trong .env.
  storage           String         @default("default")
  // Bản gốc đã chuẩn hóa: pixels đúng hướng, không còn EXIF/GPS. Dùng cho nút tải ảnh gốc và là
  // điểm xuất phát của MỌI lần chỉnh sửa (không chỉnh từ variant WebP đã nén).
  originalKey       String         @unique @map("original_key")
  originalMime      String         @map("original_mime")
  originalBytes     Int            @map("original_bytes")
  // Bộ variant đang công bố (photos/<id>/v<currentVersion>/...). Mỗi lần chỉnh sửa tạo v2, v3...
  currentVersion    Int            @default(1) @map("current_version")
  // Số version lớn nhất đã cấp (tăng nguyên tử khi bắt đầu chỉnh sửa): hai lần sửa đồng thời luôn
  // nhận hai version khác nhau nên không ghi đè file của nhau
  versionSeq        Int            @default(1) @map("version_seq")
  // Ảnh WebP 16px dạng data URL cho hiệu ứng blur-up của version đang công bố
  blurDataUrl       String?        @map("blur_data_url")
  uploadedById      String?        @map("uploaded_by_id") @db.Uuid
  uploadedBy        User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  deleteRequestedAt DateTime?      @map("delete_requested_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  variants          PhotoVariant[]
  versions          PhotoVersion[]

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([albumId])
  @@index([storage])
  @@map("photos")
}

model PhotoVariant {
  id         String   @id @default(uuid()) @db.Uuid
  photoId    String   @map("photo_id") @db.Uuid
  photo      Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  version    Int
  // Kích thước thực tế của file đã sinh
  width      Int
  height     Int
  mime       String
  bytes      Int
  storageKey String   @unique @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([photoId, version, width])
  @@map("photo_variants")
}

// Một lần lưu ảnh (bản upload là v1, mỗi lần chỉnh sửa/khôi phục thêm một version). Ghi thông số
// chỉnh sửa tính từ BẢN GỐC ĐÃ CHUẨN HÓA: cắt (tọa độ pixel của bản gốc) -> xoay -> lật ngang.
// Bản ghi chỉ được tạo trong transaction công bố, nên version có supersededAt = null là version đang
// công bố. Version cũ giữ file thêm VERSION_RETENTION_HOURS rồi tác vụ dọn xóa file và PhotoVariant.
model PhotoVersion {
  id             String    @id @default(uuid()) @db.Uuid
  photoId        String    @map("photo_id") @db.Uuid
  photo          Photo     @relation(fields: [photoId], references: [id], onDelete: Cascade)
  version        Int
  // Kích thước ảnh sau chỉnh sửa (variant lớn nhất không vượt kích thước này)
  width          Int
  height         Int
  blurDataUrl    String?   @map("blur_data_url")
  // Vùng cắt theo pixel của bản gốc; null = giữ nguyên khung
  cropX          Int?      @map("crop_x")
  cropY          Int?      @map("crop_y")
  cropWidth      Int?      @map("crop_width")
  cropHeight     Int?      @map("crop_height")
  // Góc xoay theo chiều kim đồng hồ: 0, 90, 180, 270
  rotate         Int       @default(0)
  flipH          Boolean   @default(false) @map("flip_h")
  createdAt      DateTime  @default(now()) @map("created_at")
  // Thời điểm có version mới thay thế; null = đang công bố
  supersededAt   DateTime? @map("superseded_at")
  // Thời điểm đã xóa xong file của version cũ (giữ bản ghi làm lịch sử)
  filesCleanedAt DateTime? @map("files_cleaned_at")

  @@unique([photoId, version])
  @@index([supersededAt])
  @@map("photo_versions")
}

// Key đã ghi vào kho nhưng không thuộc Photo nào đã commit (ví dụ DB lỗi sau khi ghi file và xóa bù
// cũng lỗi). Tác vụ dọn (`npm run cleanup`, nút trong Admin, hoặc định kỳ) xóa lại các key này.
model StorageCleanup {
  id         String   @id @default(uuid()) @db.Uuid
  storage    String   @default("default")
  storageKey String   @map("storage_key")
  reason     String
  // Không đặt khóa ngoại: Photo có thể chưa từng được commit
  photoId    String?  @map("photo_id") @db.Uuid
  attempts   Int      @default(0)
  lastError  String?  @map("last_error")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([storage, storageKey])
  @@map("storage_cleanups")
}
