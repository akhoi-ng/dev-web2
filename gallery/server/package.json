{
  "name": "photo-gallery-server",
  "version": "1.0.0",
  "private": true,
  "description": "Photo Gallery (Block 11) - Express + TypeScript + Prisma + sharp, lưu ảnh trên local filesystem hoặc S3-compatible (SeaweedFS, MinIO, R2, AWS S3)",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:prod": "node --env-file=.env.production dist/src/server.js",
    "db:migrate:prod": "node --env-file=.env.production node_modules/prisma/build/index.js migrate deploy",
    "db:seed:prod": "node --env-file=.env.production dist/scripts/seed.js",
    "storage:check:prod": "node --env-file=.env.production dist/scripts/storage-check.js",
    "cleanup:prod": "node --env-file=.env.production dist/scripts/cleanup.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "db:report": "tsx scripts/db-report.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "storage:check": "tsx scripts/storage-check.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "acceptance": "tsx scripts/acceptance.ts",
    "postinstall": "prisma generate",
    "db:local": "tsx scripts/db-local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "embedded-postgres": "^17.12.0-beta.19",
    "exifr": "^7.1.3",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.2"
  }
}
