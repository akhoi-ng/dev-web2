# Supabase > Project Settings > Database > Connection string
# Kết nối qua pooler (Transaction mode, cổng 6543) cho ứng dụng
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Kết nối trực tiếp (Session mode, cổng 5432) cho `prisma db push`
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
PORT=3000

# In mọi câu SQL Prisma gửi tới PostgreSQL (dùng khi lấy bằng chứng truy vấn)
# LOG_SQL=1

# ── Block 8: xác thực ──
# Khóa bí mật cho CSRF token và hash OTP, ít nhất 32 ký tự ngẫu nhiên. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Địa chỉ gốc dùng để dựng link trong email (không lấy từ header Host của request)
APP_URL=http://localhost:3000

# Cookie Secure: bật mặc định (browser vẫn nhận trên http://localhost). Đặt 0 chỉ khi thử bằng
# công cụ HTTP không gửi cookie Secure qua http.
# COOKIE_SECURE=0

# Chạy sau reverse proxy thì đặt 1 để lấy IP thật từ X-Forwarded-For (cho rate limit)
# TRUST_PROXY=1

# Tài khoản đã kích hoạt do script seed tạo (npm run db:seed hoặc npm run db:seed-user)
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Google reCAPTCHA v2 (checkbox "Tôi không phải người máy"). Tạo key miễn phí tại
#   https://www.google.com/recaptcha/admin/create  -> loại "Thử thách (v2)" -> "Hộp kiểm Tôi không phải là người máy"
#   Domain: localhost (và domain triển khai). Site key công khai; secret key chỉ để ở đây.
# Chỉ để chạy thử trên máy: Google có cặp test key luôn thành công (KHÔNG dùng làm bằng chứng chặn bot):
#   RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
#   RECAPTCHA_HOSTNAMES=localhost,testkey.google.com
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Hostname chấp nhận trong kết quả siteverify (mặc định lấy từ APP_URL), nhiều giá trị cách nhau dấu phẩy
# RECAPTCHA_HOSTNAMES=localhost

# Gửi email: file | resend | ethereal | smtp
#   file      ghi thư vào thư mục mail-outbox/ (mặc định, không cần cài gì)
#   resend    gửi thư thật qua Resend (https://resend.com): tạo tài khoản, lấy API key ở mục API Keys.
#             Chưa xác minh domain thì: người gửi phải là onboarding@resend.dev và CHỈ gửi được tới
#             email của chính tài khoản Resend. Gửi thử: npm run mail:test -- you@example.com
#   ethereal  hộp thư thử nghiệm miễn phí ethereal.email, tự tạo khi gửi thư đầu tiên (cần Internet)
#   smtp      SMTP bất kỳ (Mailpit chạy local, Gmail App Password, Mailtrap...)
MAIL_TRANSPORT=file
# Bỏ trống để dùng mặc định (resend: onboarding@resend.dev; file: no-reply@luahong.local)
MAIL_FROM=
# API key chỉ nằm ở backend, không đưa vào view hay JavaScript phía trình duyệt
RESEND_API_KEY=
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
